NODE_ENV=development
PORT=5000

# Supabase (required)
# Get these from your Supabase project: Dashboard > Project Settings > API
# Never commit real keys. Copy this file to .env and fill in your own values.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional development-only demo account. Keep these values private and unset in production.
DEMO_EMAIL=
DEMO_PASSWORD=

# Google Gemini (optional; required only when enabling the AI assistant)
# Get an API key from Google AI Studio: https://aistudio.google.com/apikey
# Keep this server-side only. Never expose it to the frontend or commit real keys.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash

# CORS (comma-separated origins, or * for all in development)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3000